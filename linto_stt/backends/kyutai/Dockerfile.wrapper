# syntax=docker/dockerfile:1
FROM python:3.12-slim
LABEL maintainer="contact@linto.ai"

# ──────────────────────────────────────────────────────────────────────────────
# 1. OS-level packages
# ──────────────────────────────────────────────────────────────────────────────
RUN apt-get update && \
    apt-get install -y --no-install-recommends ffmpeg gosu netcat-traditional && \
    rm -rf /var/lib/apt/lists/*

# ──────────────────────────────────────────────────────────────────────────────
# 2. Install uv
# ──────────────────────────────────────────────────────────────────────────────
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# ──────────────────────────────────────────────────────────────────────────────
# 3. Application code
# ──────────────────────────────────────────────────────────────────────────────
WORKDIR /usr/src/app

# Copy project files for dependency installation
COPY pyproject.toml uv.lock ./

# Install dependencies (kyutai/moshi extra is empty, uses base deps)
RUN uv sync --no-dev

# Copy application code
COPY linto_stt ./linto_stt
COPY main.py ./
COPY healthcheck.sh ./
COPY test/bonjour.wav ./test/bonjour.wav

RUN chmod +x healthcheck.sh

# ──────────────────────────────────────────────────────────────────────────────
# 4. Runtime environment
# ──────────────────────────────────────────────────────────────────────────────
ENV PYTHONPATH="/usr/src/app/linto_stt/backends/kyutai/stt:${PYTHONPATH}"

# Default WebSocket port (override at run-time if needed)
EXPOSE 8081

HEALTHCHECK CMD ./healthcheck.sh

# ──────────────────────────────────────────────────────────────────────────────
ENTRYPOINT ["uv", "run", "main.py", "-b", "kyutai"]