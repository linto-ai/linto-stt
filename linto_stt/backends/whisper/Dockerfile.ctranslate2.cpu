FROM python:3.12
LABEL maintainer="contact@linto.ai"

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends ffmpeg git curl netcat-traditional gosu portaudio19-dev

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /usr/src/app

# Copy project files for dependency installation
COPY pyproject.toml uv.lock ./

# Install dependencies with whisper-ctranslate extra
RUN uv sync --extra whisper-ctranslate --no-dev

# Copy application code
COPY linto_stt ./linto_stt
COPY main.py ./
COPY healthcheck.sh ./
COPY test/bonjour.wav ./test/bonjour.wav

ENV PYTHONPATH="${PYTHONPATH}:/usr/src/app/linto_stt/backends/whisper/stt"
ENV DEVICE=cpu

HEALTHCHECK CMD ./healthcheck.sh

ENTRYPOINT ["uv", "run", "main.py", "-b", "whisper"]
